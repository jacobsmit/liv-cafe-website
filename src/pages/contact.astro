---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';

const thankYouUrl = new URL(withBase('/thank-you'), Astro.site).href;
---

<Layout>
	<div class="bg-white text-zinc-700 min-h-screen font-sans selection:bg-orange-500 selection:text-white">
		<header class="relative py-20 px-4 border-b border-zinc-200">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-5xl md:text-6xl font-serif text-zinc-900 mb-4 tracking-wide">Reservations</h1>
				<div class="w-16 h-[2px] bg-orange-500 mx-auto"></div>
			</div>
		</header>

		<main class="max-w-5xl mx-auto py-20 px-4">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-24">
				<!-- Quick Contact Cards -->
				<section class="md:col-span-1">
					<h2 class="text-3xl font-serif text-zinc-900 mb-8">Get In Touch</h2>
					<div class="space-y-6">
						<div class="bg-orange-500 p-8 rounded-sm shadow-lg border-2 border-orange-500 text-center">
							<h3 class="text-white font-serif text-2xl mb-4 font-semibold">Prefer to Call?</h3>
							<p class="mb-2">
								<a href="tel:2505905229" class="text-white font-bold text-3xl hover:text-zinc-100 transition-colors block py-2">(250) 590-5229</a>
							</p>
							<p class="text-orange-100 text-sm font-medium">Available during business hours</p>
						</div>

						<div class="bg-zinc-50 p-8 rounded-sm border border-zinc-200">
							<h3 class="text-orange-500 font-serif text-lg mb-4">Email Us</h3>
							<p class="text-zinc-700 leading-relaxed mb-2">
								<a href="mailto:info@livcafeandbistro.com" class="text-orange-500 hover:text-orange-600 transition-colors break-all">info@livcafeandbistro.com</a>
							</p>
							<p class="text-zinc-500 text-sm">We'll respond within 24 hours</p>
						</div>

						<div class="bg-zinc-50 p-8 rounded-sm border border-zinc-200">
							<h3 class="text-orange-500 font-serif text-lg mb-4">Visit Us</h3>
							<p class="text-zinc-700 leading-relaxed mb-2">
								713 St. Patrick Street<br />
								Victoria, BC
							</p>
							<p class="text-zinc-500 text-sm">Heart of Oak Bay</p>
						</div>
					</div>
				</section>

				<!-- Reservation Form -->
				<section class="md:col-span-2">
					<h2 class="text-3xl font-serif text-zinc-900 mb-8">Make a Reservation</h2>
					<p class="text-zinc-500 mb-8">
						Fill out the form below and we'll get back to you as soon as possible to confirm your reservation.
					</p>
					<noscript>
						<p class="bg-orange-500 text-white font-bold p-6 rounded-sm mb-8">
							Our online booking form needs JavaScript enabled to pick an available time. Please <a href="tel:2505905229" class="underline">call us at (250) 590-5229</a> to reserve instead.
						</p>
					</noscript>
					<form id="reservation_form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
						<input type="hidden" name="access_key" value="e078d5cf-50ba-406c-b20d-49a516de89a0" />
						<input type="hidden" name="subject" value="New Reservation Request from Liv Café" />
						<input type="hidden" name="redirect" value={thankYouUrl} />
						<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" style="display:none" aria-hidden="true" />

						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							<div>
								<label for="res_name" class="block text-zinc-900 font-bold text-lg mb-3">Name <span class="text-orange-500">*</span></label>
								<input type="text" name="name" id="res_name" placeholder="Your name" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
							</div>

							<div>
								<label for="res_phone" class="block text-zinc-900 font-bold text-lg mb-3">Phone <span class="text-orange-500">*</span></label>
								<input type="tel" name="phone" id="res_phone" placeholder="(250) 590-5229" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
							</div>
						</div>

						<div class="mt-8">
							<label for="res_email" class="block text-zinc-900 font-bold text-lg mb-3">Email <span class="text-orange-500">*</span></label>
							<input type="email" name="email" id="res_email" placeholder="your@email.com" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
						</div>

						<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
							<div class="min-w-0">
								<label for="reservation_date" class="block text-zinc-900 font-bold text-lg mb-3">Date <span class="text-orange-500">*</span></label>
								<input type="date" name="date" id="reservation_date" required class="w-full min-w-0 max-w-full appearance-none overflow-hidden px-4 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
							</div>

							<div class="min-w-0">
								<label for="reservation_time" class="block text-zinc-900 font-bold text-lg mb-3">Time <span class="text-orange-500">*</span></label>
								<select name="time" id="reservation_time" required disabled class="w-full min-w-0 px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm appearance-none disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed">
									<option value="" disabled selected>Select date first</option>
								</select>
							</div>

							<div class="min-w-0">
								<label for="res_party_size" class="block text-zinc-900 font-bold text-lg mb-3">Party Size <span class="text-orange-500">*</span></label>
								<input type="number" name="number_of_people" id="res_party_size" placeholder="1-6" min="1" max="20" required class="w-full min-w-0 px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
								<p id="party_size_msg" class="text-orange-600 text-sm font-semibold hidden mt-2">
									For parties larger than 6, please <a href="mailto:info@livcafeandbistro.com" class="underline">email us</a> so we can best accommodate your group.
								</p>
							</div>
						</div>
						<div id="date_error_msg" class="text-orange-600 font-bold hidden -mt-4"></div>

						<div class="mt-8">
							<label for="res_event_type" class="block text-zinc-900 font-bold text-lg mb-3">Type of Event (Optional)</label>
							<input type="text" name="event_type" id="res_event_type" placeholder="e.g. Birthday, Anniversary, Business" class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
						</div>

						<div class="mt-8">
							<label for="res_food_requests" class="block text-zinc-900 font-bold text-lg mb-3">Are there any special food requests or allergies? (Optional)</label>
							<textarea name="food_requests" id="res_food_requests" placeholder="Please list any dietary requirements or allergies" rows="2" class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors resize-none shadow-sm"></textarea>
						</div>

						<div class="mt-8 flex items-start gap-3">
							<input type="checkbox" name="join_mailing_list" id="join_mailing_list" class="mt-1 w-5 h-5 accent-orange-500 shrink-0" />
							<label for="join_mailing_list" class="text-zinc-700">
								Keep me updated on specials, events, and news by email.
							</label>
						</div>

						<button type="submit" class="w-full bg-orange-500 text-white px-8 py-5 mt-10 rounded font-bold text-xl hover:bg-orange-600 transition-colors shadow-lg">
							Send Reservation Request
						</button>
						<p class="text-center text-zinc-500 text-sm mt-4">
							This is a request, not a confirmed booking. We'll follow up by email to confirm your table.
						</p>
					</form>

					<!-- Hidden mailing-list signup: submits alongside the reservation via a real
					     form navigation (into a hidden iframe) rather than a background fetch,
					     since ad-blockers/tracking protection commonly block fetch calls to
					     marketing domains but not form navigations. -->
					<iframe name="mc_signup_target" title="Mailing list signup" class="hidden" aria-hidden="true"></iframe>
					<form id="mc_signup_form" action="https://shaw.us4.list-manage.com/subscribe/post?u=a960eed57ecf2a87053739cba&id=755ee53402&f_id=0054d9e3f0" method="post" target="mc_signup_target" class="hidden" aria-hidden="true">
						<input type="hidden" name="EMAIL" id="mc_signup_email" value="" />
						<input type="text" name="b_a960eed57ecf2a87053739cba_755ee53402" tabindex="-1" autocomplete="off" value="" />
					</form>
				</section>
			</div>
		</main>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const dateInput = document.getElementById('reservation_date');
			const timeSelect = document.getElementById('reservation_time');
			const form = document.getElementById('reservation_form');
			const errorMsg = document.getElementById('date_error_msg');

			if (!dateInput || !timeSelect || !form || !errorMsg) return;

			// Set min date to today in local time
			const today = new Date();
			const yyyy = today.getFullYear();
			const mm = String(today.getMonth() + 1).padStart(2, '0');
			const dd = String(today.getDate()).padStart(2, '0');
			dateInput.min = `${yyyy}-${mm}-${dd}`;

			function updateTimes() {
				timeSelect.innerHTML = '<option value="" disabled selected>Select a time</option>';
				errorMsg.classList.add('hidden');
				timeSelect.disabled = true;

				if (!dateInput.value) return;

				// Parse date securely as local time to avoid timezone offset bugs
				const [year, month, dayStr] = dateInput.value.split('-');
				const selectedDate = new Date(year, month - 1, dayStr);
				const day = selectedDate.getDay(); // 0 = Sun, 1 = Mon, ..., 6 = Sat

				if (day === 1 || day === 2) {
					errorMsg.textContent = 'Sorry, we are closed on Mondays and Tuesdays.';
					errorMsg.classList.remove('hidden');
					return;
				}

				let availableTimes = [];

				// Brunch/Lunch (Wed-Sun) — fixed slot lists, not evenly spaced
				const weekendBrunchTimes = [
					{ val: '9:30', label: '9:30 AM' },
					{ val: '9:45', label: '9:45 AM' },
					{ val: '10:00', label: '10:00 AM' },
					{ val: '11:15', label: '11:15 AM' },
					{ val: '11:30', label: '11:30 AM' },
					{ val: '11:45', label: '11:45 AM' },
					{ val: '13:00', label: '1:00 PM' },
					{ val: '13:15', label: '1:15 PM' },
					{ val: '13:30', label: '1:30 PM' },
				];
				const weekdayBrunchTimes = [
					{ val: '10:00', label: '10:00 AM' },
					{ val: '10:15', label: '10:15 AM' },
					{ val: '10:30', label: '10:30 AM' },
					{ val: '10:45', label: '10:45 AM' },
					{ val: '11:00', label: '11:00 AM' },
					{ val: '11:15', label: '11:15 AM' },
					{ val: '11:30', label: '11:30 AM' },
					{ val: '11:45', label: '11:45 AM' },
					{ val: '13:00', label: '1:00 PM' },
					{ val: '13:15', label: '1:15 PM' },
					{ val: '13:30', label: '1:30 PM' },
				];

				if (day >= 3 || day === 0) {
					const brunchTimes = (day === 0 || day === 6) ? weekendBrunchTimes : weekdayBrunchTimes;
					availableTimes.push(...brunchTimes);
				}

				// Dinner (Thu, Fri, Sat)
				if (day >= 4 && day <= 6) {
					let h = 17, m = 0;
					// Up to 7:45 PM (closes at 9:00pm)
					while (h < 19 || (h === 19 && m <= 45)) {
						const displayH = h > 12 ? h - 12 : h;
						const mm = String(m).padStart(2, '0');
						const timeStr = `${displayH}:${mm} PM`;
						availableTimes.push({ val: `${h}:${mm}`, label: timeStr });
						m += 15;
						if (m >= 60) { m -= 60; h++; }
					}
				}

				// If selected date is today, filter out past times
				const isToday = dateInput.value === `${yyyy}-${mm}-${dd}`;
				const currentHour = today.getHours();
				const currentMin = today.getMinutes();

				if (isToday) {
					availableTimes = availableTimes.filter(t => {
						const [th, tm] = t.val.split(':').map(Number);
						if (th < currentHour) return false;
						if (th === currentHour && tm <= currentMin) return false;
						return true;
					});
					if (availableTimes.length === 0) {
						errorMsg.textContent = 'No available times left for today. Please select another date.';
						errorMsg.classList.remove('hidden');
						return;
					}
				}

				availableTimes.forEach(t => {
					const opt = document.createElement('option');
					opt.value = t.label;
					opt.textContent = t.label;
					timeSelect.appendChild(opt);
				});

				timeSelect.disabled = false;
			}

			dateInput.addEventListener('change', updateTimes);

			const partySizeInput = document.getElementById('res_party_size');
			const partySizeMsg = document.getElementById('party_size_msg');

			function partySizeIsValid() {
				const size = parseInt(partySizeInput.value, 10);
				const tooLarge = !isNaN(size) && size > 6;
				partySizeMsg.classList.toggle('hidden', !tooLarge);
				return !tooLarge;
			}

			if (partySizeInput && partySizeMsg) {
				partySizeInput.addEventListener('input', partySizeIsValid);
			}

			const mailingListCheckbox = document.getElementById('join_mailing_list');
			const emailInput = document.getElementById('res_email');
			const mcForm = document.getElementById('mc_signup_form');
			const mcEmailField = document.getElementById('mc_signup_email');

			form.addEventListener('submit', (e) => {
				if (timeSelect.disabled || !timeSelect.value) {
					e.preventDefault();
					errorMsg.textContent = 'Please select a valid date and time before submitting.';
					errorMsg.classList.remove('hidden');
					return;
				}

				if (partySizeInput && partySizeMsg && !partySizeIsValid()) {
					e.preventDefault();
					return;
				}

				if (mailingListCheckbox && mailingListCheckbox.checked && emailInput && emailInput.value && mcForm && mcEmailField) {
					mcEmailField.value = emailInput.value;
					mcForm.submit();
				}
			});
		});
	</script>
</Layout>
