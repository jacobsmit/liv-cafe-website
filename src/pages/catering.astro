---
// src/pages/catering.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import cateringImg from '../assets/3BC55C12-0B88-4826-A269-3F37B56D2F06_1_201_a.jpeg';

const thankYouUrl = new URL(`${import.meta.env.BASE_URL}/thank-you`, Astro.site).href;
---

<Layout>
	<div class="bg-white text-zinc-700 min-h-screen font-sans selection:bg-orange-500 selection:text-white">
		<header class="relative py-20 px-4 border-b border-zinc-200">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-5xl md:text-6xl font-serif text-zinc-900 mb-4 tracking-wide">Catering</h1>
				<div class="w-16 h-[2px] bg-orange-500 mx-auto"></div>
			</div>
		</header>

		<main class="max-w-6xl mx-auto py-20 px-4">
			<!-- Featured Section -->
			<section class="mb-24 bg-zinc-50 rounded-sm overflow-hidden shadow-2xl border border-zinc-200">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-0 md:min-h-96">
					<div class="h-80 md:h-auto overflow-hidden group">
						<Image src={cateringImg} width={800} alt="Chef-driven catering" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
					</div>
					<div class="p-12 flex flex-col justify-center">
						<h2 class="text-3xl font-serif text-zinc-900 mb-4">Chef Driven Catering</h2>
						<p class="text-zinc-700 leading-relaxed mb-6 font-light">
							From small intimate gatherings to chef-driven five-course dinners at your home or any venue in and surrounding Oak Bay and Greater Victoria, we are passionate about what we do, and we strive to ensure all our celebrations are exceptional.
						</p>
						<p class="text-orange-500 font-serif text-xl">
							We bring fine dining to you!
						</p>
					</div>
				</div>
			</section>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-24">
				<!-- Left Column -->
				<section class="mb-16 md:mb-0">
					<h2 class="text-3xl font-serif text-zinc-900 mb-6">Our Offerings</h2>
					<ul class="text-zinc-700 leading-relaxed space-y-4 border-l-2 border-orange-500 pl-6">
						<li class="flex items-start gap-3">
							<span class="text-orange-500 mt-1">✦</span>
							<span>Canapés & Appetizers</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-orange-500 mt-1">✦</span>
							<span>Charcuterie Boards</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-orange-500 mt-1">✦</span>
							<span>Dessert Platters</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-orange-500 mt-1">✦</span>
							<span>Family Style Dinners</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="text-orange-500 mt-1">✦</span>
							<span>Custom Multi-Course Menus</span>
						</li>
					</ul>

					<a href={`${import.meta.env.BASE_URL}/menus/RECEPTION_CANAPE_2026.pdf`} download class="inline-block mt-8 border border-orange-500 text-orange-500 px-6 py-3 uppercase tracking-widest text-sm hover:bg-orange-500 hover:text-white transition-all duration-300 font-semibold">
						Download Sample Canape Menu
					</a>
				</section>

				<!-- Right Column -->
				<section>
					<h2 class="text-3xl font-serif text-zinc-900 mb-6">Philosophy</h2>
					<div class="bg-zinc-50 rounded-sm p-8 border border-zinc-200">
						<p class="text-orange-500 font-serif text-xl mb-4">
							Farm Fueled ~ Chef Driven
						</p>
						<p class="text-zinc-700 leading-relaxed">
							All our catering uses the same philosophy as our restaurant: seasonal, locally sourced, and beautifully presented. We believe in creating memorable experiences through exceptional food.
						</p>
					</div>
				</section>
			</div>

			<!-- Catering Inquiry Form -->
			<section class="max-w-3xl mx-auto">
				<h2 class="text-3xl font-serif text-zinc-900 mb-4 text-center">Request a Catering Quote</h2>
				<p class="text-zinc-500 mb-10 text-center">
					Tell us about your event and we'll get back to you to help plan the details.
				</p>

				<form id="catering_form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
					<input type="hidden" name="access_key" value="e078d5cf-50ba-406c-b20d-49a516de89a0" />
					<input type="hidden" name="subject" value="New Catering Inquiry from Liv Café" />
					<input type="hidden" name="redirect" value={thankYouUrl} />
					<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" style="display:none" aria-hidden="true" />

					<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
						<div>
							<label for="cat_name" class="block text-zinc-900 font-bold text-lg mb-3">Name <span class="text-orange-500">*</span></label>
							<input type="text" name="name" id="cat_name" placeholder="Your name" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
						</div>

						<div>
							<label for="cat_phone" class="block text-zinc-900 font-bold text-lg mb-3">Phone <span class="text-orange-500">*</span></label>
							<input type="tel" name="phone" id="cat_phone" placeholder="(250) 590-5229" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
						</div>
					</div>

					<div>
						<label for="cat_email" class="block text-zinc-900 font-bold text-lg mb-3">Email <span class="text-orange-500">*</span></label>
						<input type="email" name="email" id="cat_email" placeholder="your@email.com" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
					</div>

					<div>
						<label for="cat_date" class="block text-zinc-900 font-bold text-lg mb-3">Event Date (Optional)</label>
						<input type="date" name="event_date" id="cat_date" class="w-full min-w-0 max-w-full appearance-none overflow-hidden px-4 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
					</div>

					<div>
						<label for="cat_message" class="block text-zinc-900 font-bold text-lg mb-3">Tell Us About Your Event <span class="text-orange-500">*</span></label>
						<textarea name="message" id="cat_message" placeholder="Guest count, event type, venue, and any other details that will help us plan." rows="5" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors resize-none shadow-sm"></textarea>
					</div>

					<button type="submit" class="w-full bg-orange-500 text-white px-8 py-5 mt-4 rounded font-bold text-xl hover:bg-orange-600 transition-colors shadow-lg">
						Send Catering Inquiry
					</button>
				</form>
			</section>
		</main>
	</div>
</Layout>
