---
// src/pages/special-events.astro
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
import fs from 'node:fs';
import path from 'node:path';

const thankYouUrl = new URL(withBase('/thank-you'), Astro.site).href;

const eventsFile = path.join(process.cwd(), 'public/events/events.json');
let events = [];
if (fs.existsSync(eventsFile)) {
	try {
		events = JSON.parse(fs.readFileSync(eventsFile, 'utf-8'));
	} catch {
		events = [];
	}
}

function formatDate(dateStr) {
	const [year, month, day] = dateStr.split('-').map(Number);
	return new Date(year, month - 1, day).toLocaleDateString('en-US', {
		weekday: 'long',
		month: 'long',
		day: 'numeric',
		year: 'numeric',
	});
}
---

<Layout>
	<div class="bg-white text-zinc-700 min-h-screen font-sans selection:bg-orange-500 selection:text-white">
		<header class="relative py-20 px-4 border-b border-zinc-200">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-5xl md:text-6xl font-serif text-zinc-900 mb-4 tracking-wide">Special Events</h1>
				<div class="w-16 h-[2px] bg-orange-500 mx-auto"></div>
			</div>
		</header>

		<main class="max-w-5xl mx-auto py-20 px-4">
			{events.length === 0 ? (
				<section class="text-center py-16">
					<p class="text-2xl font-serif text-zinc-700 mb-4">No special dinners currently planned.</p>
					<p class="text-zinc-500">Check back soon, or follow us on Instagram for announcements.</p>
				</section>
			) : (
				<section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
					{events.map((event) => (
						<div class="bg-zinc-50 border border-zinc-200 rounded-sm p-8 shadow-sm">
							<h2 class="text-2xl font-serif text-zinc-900 mb-2">{event.name}</h2>
							<p class="text-orange-500 font-semibold mb-6">{formatDate(event.date)}</p>
							<a href={withBase(event.file)} target="_blank" rel="noopener noreferrer" class="inline-block bg-orange-500 text-white px-6 py-3 rounded font-semibold hover:bg-orange-600 transition-colors shadow-sm">
								View Details
							</a>
						</div>
					))}
				</section>
			)}

			{events.length > 0 && (
				<section class="max-w-3xl mx-auto">
					<h2 class="text-3xl font-serif text-zinc-900 mb-4 text-center">Reserve for a Special Event</h2>
					<p class="text-zinc-500 mb-10 text-center">
						Fill out the form below and we'll get back to you to confirm your spot.
					</p>

					<form id="special_event_form" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
						<input type="hidden" name="access_key" value="eb5bcc4e-9c39-45bf-9f72-c0aa5439dde0" />
						<input type="hidden" name="subject" value="New Special Event Reservation Request" />
						<input type="hidden" name="redirect" value={thankYouUrl} />
						<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" style="display:none" aria-hidden="true" />

						<div>
							<label for="event_choice" class="block text-zinc-900 font-bold text-lg mb-3">Which Event? <span class="text-orange-500">*</span></label>
							<select name="event" id="event_choice" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm appearance-none cursor-pointer">
								<option value="" disabled selected>Select an event</option>
								{events.map((event) => (
									<option value={`${event.name} (${formatDate(event.date)})`}>{event.name} — {formatDate(event.date)}</option>
								))}
							</select>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							<div>
								<label for="se_name" class="block text-zinc-900 font-bold text-lg mb-3">Name <span class="text-orange-500">*</span></label>
								<input type="text" name="name" id="se_name" placeholder="Your name" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
							</div>

							<div>
								<label for="se_phone" class="block text-zinc-900 font-bold text-lg mb-3">Phone <span class="text-orange-500">*</span></label>
								<input type="tel" name="phone" id="se_phone" placeholder="(250) 590-5229" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
							</div>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
							<div>
								<label for="se_email" class="block text-zinc-900 font-bold text-lg mb-3">Email <span class="text-orange-500">*</span></label>
								<input type="email" name="email" id="se_email" placeholder="your@email.com" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
							</div>

							<div>
								<label for="se_party_size" class="block text-zinc-900 font-bold text-lg mb-3">Party Size <span class="text-orange-500">*</span></label>
								<input type="number" name="number_of_people" id="se_party_size" placeholder="1-6" min="1" max="20" required class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
								<p id="se_party_size_msg" class="text-orange-600 text-sm font-semibold hidden mt-2">
									For parties larger than 6, please <a href="mailto:info@livcafeandbistro.com" class="underline">email us</a> so we can best accommodate your group.
								</p>
							</div>
						</div>

						<div>
							<label for="se_message" class="block text-zinc-900 font-bold text-lg mb-3">Anything else we should know? (Optional)</label>
							<textarea name="message" id="se_message" placeholder="Dietary requirements, allergies, special requests" rows="3" class="w-full px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors resize-none shadow-sm"></textarea>
						</div>

						<button type="submit" class="w-full bg-orange-500 text-white px-8 py-5 mt-4 rounded font-bold text-xl hover:bg-orange-600 transition-colors shadow-lg">
							Send Reservation Request
						</button>
						<p class="text-center text-zinc-500 text-sm mt-4">
							This is a request, not a confirmed booking. We'll follow up by email to confirm your spot.
						</p>
					</form>
				</section>
			)}
		</main>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const partySizeInput = document.getElementById('se_party_size');
			const partySizeMsg = document.getElementById('se_party_size_msg');
			const form = document.getElementById('special_event_form');

			if (!partySizeInput || !partySizeMsg || !form) return;

			function partySizeIsValid() {
				const size = parseInt(partySizeInput.value, 10);
				const tooLarge = !isNaN(size) && size > 6;
				partySizeMsg.classList.toggle('hidden', !tooLarge);
				return !tooLarge;
			}

			partySizeInput.addEventListener('input', partySizeIsValid);

			form.addEventListener('submit', (e) => {
				if (!partySizeIsValid()) {
					e.preventDefault();
				}
			});
		});
	</script>
</Layout>
