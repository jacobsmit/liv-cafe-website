---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import gardenImg from '../assets/IMG_7285.jpeg';
---

<Layout>
	<div class="bg-white text-zinc-700 min-h-screen font-sans selection:bg-orange-500 selection:text-white">
		<header class="relative py-20 px-4 border-b border-zinc-200">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-5xl md:text-6xl font-serif text-zinc-900 mb-4 tracking-wide">About</h1>
				<div class="w-16 h-[2px] bg-orange-500 mx-auto"></div>
			</div>
		</header>

		<main class="max-w-6xl mx-auto py-20 px-4">
			<!-- Philosophy, Seasonal Menus & Edible Gardens Section with Image -->
			<section class="mb-24 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
				<div class="h-96 rounded-sm shadow-2xl overflow-hidden group order-2 md:order-1">
					<Image src={gardenImg} width={800} alt="Liv's Edible Gardens, our farm in Saanich" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
				</div>
				<div class="order-1 md:order-2 space-y-12">
					<div>
						<h2 class="text-4xl font-serif text-zinc-900 mb-6">Our Philosophy</h2>
						<div class="border-l-4 border-orange-500 pl-6 space-y-6">
							<p class="text-zinc-700 leading-relaxed text-2xl font-light">
								A cocoon to Liv a little. Nestled within Oak Bay, Liv is an ingredient-driven restaurant founded by Chefs Louise Lu and Milton Rebello.
							</p>
						</div>
					</div>

					<div>
						<h2 class="text-3xl font-serif text-zinc-900 mb-6">Seasonal Menus & Edible Gardens</h2>
						<div class="border-l-4 border-orange-500 pl-6 space-y-6">
							<p class="text-zinc-700 leading-relaxed text-xl font-light">
								Our menu changes seasonally, reflecting what grows locally. Much of the produce is homegrown from our own farm in Saanich, 'Liv's Edible Gardens'. We believe in creating exceptional experiences through sustainable, locally-sourced ingredients.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Newsletter Signup -->
			<section class="max-w-2xl mx-auto text-center bg-zinc-50 border border-zinc-200 rounded-sm p-12">
				<h2 class="text-3xl font-serif text-zinc-900 mb-4">Liv a Little With Us</h2>
				<p class="text-zinc-600 leading-relaxed mb-8">
					Join our mailing list for seasonal menu updates, farm news, and the occasional invitation to something special.
				</p>
				<form
					id="about_newsletter_form"
					action="https://shaw.us4.list-manage.com/subscribe/post?u=a960eed57ecf2a87053739cba&id=755ee53402&f_id=0054d9e3f0"
					method="post"
					target="_blank"
					rel="noopener"
					class="flex flex-col sm:flex-row gap-4 justify-center"
				>
					<input type="email" id="newsletter_email" name="EMAIL" placeholder="your@email.com" required class="flex-grow sm:max-w-xs px-6 py-4 bg-white border-2 border-zinc-300 text-zinc-900 text-lg placeholder-zinc-400 rounded focus:border-orange-500 focus:outline-none transition-colors shadow-sm" />
					<input type="text" name="b_a960eed57ecf2a87053739cba_755ee53402" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
					<button type="submit" class="bg-orange-500 text-white px-8 py-4 rounded font-bold text-lg hover:bg-orange-600 transition-colors shadow-lg whitespace-nowrap">
						Subscribe
					</button>
				</form>
				<p class="mt-4 text-sm text-zinc-500">A confirmation will open in a new tab.</p>
			</section>
		</main>
	</div>
</Layout>
